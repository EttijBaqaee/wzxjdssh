# 1Panel 编排环境参数；未设置时同样默认使用 2222。
# 改成 WZXJDSSH_PORT=22 即发布到宿主机 22 端口。
WZXJDSSH_PORT=2222

# SSH 版本标识；留空或删除时默认使用 Debian 标识。
# 自定义示例：WZXJDSSH_SERVER_VERSION=SSH-2.0-OpenSSH_9.9
WZXJDSSH_SERVER_VERSION=

# Web UI 默认仅绑定宿主机回环地址；直接远程访问可改为 0.0.0.0。
WZXJDSSH_WEB_BIND=127.0.0.1
WZXJDSSH_WEB_PORT=2223
# 必填，至少 12 字节。不要把实际密码提交到 Git。
WZXJDSSH_ADMIN_USERNAME=admin
WZXJDSSH_ADMIN_PASSWORD=
# 可留空，或设置为 /sshpanel 等路径前缀。
WZXJDSSH_WEB_BASE_PATH=
# 通过 HTTPS 反代访问时设为 true。
WZXJDSSH_WEB_SECURE_COOKIE=false
WZXJDSSH_RETENTION_DAYS=90

# 数据库容量上限，单位 MiB；留空或 0 不启用。1024 = 1 GiB。
# 超过后从最旧连接及认证记录开始清理，并回收 SQLite/WAL 空间。
WZXJDSSH_DATABASE_MAX_MB=
# 单连接认证次数；0 不限制次数，慢速阶段不限总持续时间。
WZXJDSSH_MAX_AUTH_TRIES=0

# 接入与慢速策略；环境参数覆盖配置文件，命令行选项最后生效。
# 每 IP 每分钟接入：0 关闭限制；每 IP 并发也支持 0 关闭限制。
WZXJDSSH_CONNECTIONS_PER_MINUTE=2048
WZXJDSSH_MAX_CLIENTS=4096
WZXJDSSH_MAX_CLIENTS_PER_IP=64
WZXJDSSH_MAX_PENDING_HANDSHAKES=128
WZXJDSSH_DELAY_MS=10000
# 普通认证、横幅及并发慢速响应的独立随机扰动，0–50%。
WZXJDSSH_DELAY_JITTER_PERCENT=10
WZXJDSSH_PARALLEL_WINDOW_MS=60000
WZXJDSSH_PARALLEL_CONNECTIONS=2
# 同 IP 并发慢速标记：最后一条连接断开后，闲置 1 小时冷却。
WZXJDSSH_PARALLEL_COOLDOWN_MS=3600000
WZXJDSSH_HANDSHAKE_TIMEOUT_MS=20000
WZXJDSSH_IDLE_TIMEOUT_MS=120000
WZXJDSSH_WRITE_TIMEOUT_MS=5000
# 0 不限；非零仅限制慢速阶段前，慢速连接仍不限时。
WZXJDSSH_MAX_CONNECTION_TIME_MS=0
WZXJDSSH_MODE=ssh
WZXJDSSH_MAX_LINE_LENGTH=32
WZXJDSSH_LOG_LEVEL=0

# 兼容旧版 IP 握手探针冷却；2.0.5 无凭据规则按连接处理，不增加 IP 计数。
WZXJDSSH_PROBE_FAILURE_THRESHOLD=3
WZXJDSSH_PROBE_COOLDOWN_MS=900000

# 冷却重连的自适应认证等待；学习仅在内存保留至标记到期。
WZXJDSSH_COOLDOWN_AUTH_DELAY_MS=10000
WZXJDSSH_COOLDOWN_AUTH_DELAY_MIN_MS=3000
WZXJDSSH_COOLDOWN_AUTH_DELAY_MAX_MS=15000
WZXJDSSH_COOLDOWN_AUTH_DELAY_STEP_MS=1000
WZXJDSSH_COOLDOWN_AUTH_JITTER_PERCENT=10

# Repeated single-password rejection followed by client departure.
WZXJDSSH_SINGLE_AUTH_RETRY_THRESHOLD=3
WZXJDSSH_SINGLE_AUTH_RETRY_WINDOW_MS=900000
WZXJDSSH_SINGLE_AUTH_RETRY_COOLDOWN_MS=3600000

# SSH 应用层存活核验，分别为间隔、响应窗口（毫秒）、最大无响应窗口数。
WZXJDSSH_SSH_KEEPALIVE_INTERVAL_MS=60000
WZXJDSSH_SSH_KEEPALIVE_TIMEOUT_MS=30000
WZXJDSSH_SSH_KEEPALIVE_COUNT_MAX=3

# 无凭据探针按连接处理；从接入起计时，不影响同 IP 的其他连接。
WZXJDSSH_CREDENTIAL_TIMEOUT_MS=20000

# 本地 IP 归属库；默认位于 records 卷下 ipdb/，无需增加挂载。
WZXJDSSH_IPDB_ENABLED=true
WZXJDSSH_IPDB_AUTO_UPDATE=true
WZXJDSSH_IPDB_UPDATE_DAYS=45
WZXJDSSH_IPDB_CACHE_SIZE=300
WZXJDSSH_IPDB_CACHE_TTL_SECONDS=300
# 高级选项：自定义目录必须可写并持久化；下载 URL 必须使用 HTTPS。
# WZXJDSSH_IPDB_DIRECTORY=/var/lib/wzxjdssh/ipdb
# WZXJDSSH_IPDB_CITY_URL=https://example.com/GeoLite2-City.mmdb.gz
# WZXJDSSH_IPDB_ASN_URL=https://example.com/GeoLite2-ASN.mmdb.gz
# WZXJDSSH_IPDB_GEOCN_URL=https://example.com/GeoCN.mmdb.gz
