# 1Panel 编排环境参数；未设置时同样默认使用 2222。
# 改成 WZXJDSSH_PORT=22 即发布到宿主机 22 端口。
WZXJDSSH_PORT=2222

# SSH 版本标识；留空或删除时默认使用 Debian 标识。
# 自定义示例：WZXJDSSH_SERVER_VERSION=SSH-2.0-OpenSSH_9.9
WZXJDSSH_SERVER_VERSION=

# Web UI 默认仅绑定宿主机回环地址；直接远程访问可改为 0.0.0.0。
WZXJDSSH_WEB_BIND=127.0.0.1
WZXJDSSH_WEB_PORT=2223
# 必填，至少 12 字节。不要把实际密码提交到 Git。
WZXJDSSH_ADMIN_USERNAME=admin
WZXJDSSH_ADMIN_PASSWORD=
# 可留空，或设置为 /sshpanel 等路径前缀。
WZXJDSSH_WEB_BASE_PATH=
# 通过 HTTPS 反代访问时设为 true。
WZXJDSSH_WEB_SECURE_COOKIE=false
WZXJDSSH_RETENTION_DAYS=90

# 数据库容量上限，单位 MiB；留空或 0 不启用。1024 = 1 GiB。
# 超过后从最旧连接及认证记录开始清理，并回收 SQLite/WAL 空间。
WZXJDSSH_DATABASE_MAX_MB=
# 单连接认证次数；0 不限制次数，慢速阶段不限总持续时间。
WZXJDSSH_MAX_AUTH_TRIES=0
